                <TextBlock Text="任务保存后，点击上方“启用定时运行”开始按时执行。可同时启动任意数量的任务；实际速度取决于电脑资源和领星响应。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,15,0,0"/>
              </StackPanel></Border>

<Border x:Name="BatchCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="批量采集计划" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="使用上方任务编辑器的通道、类型、日期和运行时间。商品和国家各行一个，先预览，再保存。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,12"><TextBlock Text="任务组名称" Style="{StaticResource Label}"/><TextBox x:Name="BatchGroupBox" MinHeight="38" Text="批量采集"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="当前单项任务所属组" Style="{StaticResource Label}"/><TextBox x:Name="AutoGroupBox" MinHeight="38" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="商品标识／品名，每行一个" Style="{StaticResource Label}"/><TextBox x:Name="BatchValuesBox" MinHeight="38" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="国家，每行一个；留空表示全部" Style="{StaticResource Label}"/><TextBox x:Name="BatchCountriesBox" MinHeight="38" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto"/></StackPanel></UniformGrid><WrapPanel><Button x:Name="BatchPreviewButton" Content="预览计划" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/><Button x:Name="BatchSaveButton" Content="保存预览计划" Margin="0,0,8,8"/><Button x:Name="BatchCloseButton" Content="收起" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="BatchNotice" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><DataGrid x:Name="BatchPreviewGrid" Height="180" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="商品 / 范围" Binding="{Binding Scope}" Width="*"/><DataGridTextColumn Header="通道" Binding="{Binding Source}" Width="75"/><DataGridTextColumn Header="时间" Binding="{Binding Timing}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="运行记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="AutoRunsGrid" Height="240"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="开始时间" Binding="{Binding Started}" Width="155"/><DataGridTextColumn Header="日期范围" Binding="{Binding Dates}" Width="205"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="350"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,14,0,0"><Button x:Name="AutoViewResultButton" Content="查看选中结果" Margin="0,0,9,0"/><Button x:Name="AutoViewLogButton" Content="查看选中日志"/></WrapPanel></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="McpPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="780" HorizontalAlignment="Left"><StackPanel>
            <TextBlock Text="领星 MCP" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="同一个领星数据源，两种采集通道。MCP 使用这里保存的授权直接取数，独立于浏览器登录。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,24"/>
            <TextBlock Text="服务地址" Style="{StaticResource Label}"/><TextBox x:Name="McpUrlBox" Height="44"/>
            <Grid Margin="0,20,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="认证头" Style="{StaticResource Label}"/><ComboBox x:Name="McpHeaderBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="连接方式" Style="{StaticResource Label}"/><ComboBox x:Name="McpTransportBox"/></StackPanel></Grid>
            <TextBlock Text="密钥（保存后不回显）" Style="{StaticResource Label}"/><PasswordBox x:Name="McpKeyBox" Height="44"/>
            <TextBlock x:Name="McpSavedText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,20"/>
            <WrapPanel><Button x:Name="McpSaveButton" Content="保存连接" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/><Button x:Name="McpImportButton" Content="从 Codex 导入" Margin="0,0,10,10"/><Button x:Name="McpTestButton" Content="测试已保存连接" Margin="0,0,0,10"/></WrapPanel>
            <Button x:Name="LoadScopeButton" Content="加载授权国家与店铺" Margin="0,0,8,8"/><TextBlock x:Name="ScopeNotice" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="McpNotice" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <TextBlock Text="Windows 密钥由当前用户的系统保护机制加密保存。更新或导入连接不会改动已保存任务的采集通道。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,24,0,0"/>
          </StackPanel></Border><Border Style="{StaticResource Card}" MaxWidth="780" HorizontalAlignment="Left" Margin="0,16,0,0"><StackPanel><TextBlock Text="浏览器采集" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="使用专用 Chrome 登录领星，按查询条件读取产品表现。" Foreground="{StaticResource Muted}" Margin="0,10,0,12"/><TextBlock Text="登录失效时，从一次手动采集重新登录。现有登录状态保存在本机。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><Button x:Name="BrowserCollectButton" Content="使用浏览器采集" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>

          <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="窗口与后台运行" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="CloseToTrayBox" Content="关闭窗口后在托盘后台运行" Margin="0,24,0,16"/><TextBlock Text="开启后，点击窗口关闭按钮会隐藏到系统托盘，当前采集继续运行。双击托盘图标恢复窗口，右键可打开设置或退出软件。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBlock Text="关闭此选项后，关闭窗口会退出软件；采集进行中仍需等待完成。此开关只管理软件窗口，系统定时采集与监控由各自的总开关控制。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SettingsNotice" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
          <ScrollViewer x:Name="MonitorPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel><TextBlock Text="监控运行设置" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MonitorStatusText" Text="监控尚未启用" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><CheckBox x:Name="MonitorEnabledBox" Content="启用后台监控" HorizontalAlignment="Right"/></Grid><UniformGrid Columns="3" Margin="0,18,0,0"><StackPanel Margin="0,0,12,12"><TextBlock Text="库存检查间隔（分钟）" Style="{StaticResource Label}"/><TextBox x:Name="InventoryIntervalBox" MinHeight="38" Text="30"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="站内信检查间隔（分钟）" Style="{StaticResource Label}"/><TextBox x:Name="MailIntervalBox" MinHeight="38" Text="5"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="站内信重复提醒（分钟）" Style="{StaticResource Label}"/><TextBox x:Name="MailRepeatBox" MinHeight="38" Text="120"/></StackPanel></UniformGrid><CheckBox x:Name="MailEnabledBox" Content="监控领星售后邮件 → 站内信（待回复 / 超时）" Margin="0,0,0,15"/><TextBlock Text="站内信复用软件保存的领星网页登录态。按店铺提示待回复与超时数量，回复后更新状态。电脑需开机、联网并保持唤醒。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button x:Name="MonitorSaveButton" Content="保存监控设置" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/><Button x:Name="MonitorCheckButton" Content="立即检查" Margin="0,0,8,8"/><Button x:Name="MonitorRefreshButton" Content="刷新提醒" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="MonitorNotice" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="FBA 可售库存规则" FontSize="17" FontWeight="SemiBold"/><Button x:Name="RuleNewButton" Content="新建规则" HorizontalAlignment="Right"/></Grid><DataGrid x:Name="InventoryRulesGrid" Height="150" Margin="0,15,0,15"><DataGrid.Columns><DataGridTextColumn Header="规则" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="商品 / 范围" Binding="{Binding Scope}" Width="*"/><DataGridTextColumn Header="阈值（小于时提醒）" Binding="{Binding Threshold}" Width="145"/><DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="75"/></DataGrid.Columns></DataGrid><UniformGrid Columns="3"><StackPanel Margin="0,0,12,12"><TextBlock Text="规则名称" Style="{StaticResource Label}"/><TextBox x:Name="RuleNameBox" MinHeight="38" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="商品类型" Style="{StaticResource Label}"/><ComboBox x:Name="RuleTypeBox" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="商品标识／品名" Style="{StaticResource Label}"/><TextBox x:Name="RuleValueBox" MinHeight="38" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="国家" Style="{StaticResource Label}"/><ComboBox x:Name="RuleCountryBox" IsEditable="True"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="店铺（可留空）" Style="{StaticResource Label}"/><ComboBox x:Name="RuleShopBox" IsEditable="True"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="FBA 可售阈值" Style="{StaticResource Label}"/><TextBox x:Name="RuleThresholdBox" MinHeight="38" Text="10"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="库存重复提醒（分钟）" Style="{StaticResource Label}"/><TextBox x:Name="RuleCooldownBox" MinHeight="38" Text="120"/></StackPanel></UniformGrid><CheckBox x:Name="RuleEnabledBox" Content="启用此规则" IsChecked="True" Margin="0,0,0,15"/><WrapPanel><Button x:Name="RuleSaveButton" Content="保存规则" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/><Button x:Name="RuleDeleteButton" Content="删除选中规则" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="仅比较 FBA 可售库存，等于阈值时不报警；读取失败和缺失值会显示异常。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="提醒中心" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="ReminderGrid" Height="250" Margin="0,15,0,15"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="75"/><DataGridTextColumn Header="提醒" Binding="{Binding Title}" Width="210"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="更新时间" Binding="{Binding Updated}" Width="140"/></DataGrid.Columns></DataGrid><WrapPanel><Button x:Name="ReminderReadButton" Content="标为已读" Margin="0,0,8,8"/><Button x:Name="ReminderSnoozeButton" Content="一小时后再提醒" Margin="0,0,8,8"/><Button x:Name="ReminderOpenButton" Content="打开领星相关页面" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer>
          <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><TextBlock Text="本次运行的输出与错误信息" Foreground="{StaticResource Muted}"/><Button x:Name="ClearLogButton" Content="清空显示" HorizontalAlignment="Right"/></Grid><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#111315" Foreground="#BEC6D0" Padding="18"/></Grid>

        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
